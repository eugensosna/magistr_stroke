root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true

[*.adoc]
# у AsciiDoc " +" в кінці рядка — примусовий перенос, його не можна обрізати
trim_trailing_whitespace = false

[*.{py,lua,rb}]
indent_style = space
indent_size = 4

[*.{lua,rb}]
indent_size = 2

[Makefile]
indent_style = tab
